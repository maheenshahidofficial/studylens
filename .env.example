# Secret key used to sign JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-here

# Your Groq API key for AI analysis and tutor calls.
# Get one free at https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key-here

# Groq model to use. Default is openai/gpt-oss-120b (current Groq production model).
# Set this in Vercel environment variables if you want to override.
GROQ_MODEL=openai/gpt-oss-120b

# Database URL.
# Local development (SQLite):   DATABASE_URL=studylens.db
# Production (Neon PostgreSQL): DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=studylens.db

# Upload directory for PDF files.
# Local:   UPLOAD_ROOT=uploads
# Vercel:  UPLOAD_ROOT=/tmp/uploads  (ephemeral; files only needed for duration of one request)
UPLOAD_ROOT=uploads

# Flask environment.
# Local:   FLASK_ENV=development
# Vercel:  FLASK_ENV=production
FLASK_ENV=development