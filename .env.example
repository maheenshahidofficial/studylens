# Secret key used to sign JWT tokens. Use a random 64-character hex string.
JWT_SECRET=your-secret-key-here

# Your Groq API key for AI analysis calls.
# Get one free at https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key-here

# (Optional) Groq model to use. Defaults to openai/gpt-oss-120b if not set.
GROQ_MODEL=openai/gpt-oss-120b

# Absolute path to the directory where uploaded PDFs will be stored.
UPLOAD_ROOT=./uploads

# Path to the SQLite database file.
DATABASE_URL=./studylens.db

# Flask environment: use 'development' locally and 'production' on Render.
FLASK_ENV=development
